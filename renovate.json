{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":disableDependencyDashboard"],
  "baseBranchPatterns": ["dev"],
  "enabledManagers": ["cargo"],
  "labels": ["dependencies"],
  "ignorePaths": [
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "**/crate/**",
    "shared/**"
  ],
  "rangeStrategy": "update-lockfile",
  "constraints": {"rust": "1.95.0"},
  "constraintsFiltering": "strict",
  "automerge": false,
  "packageRules": [
    {
      "semanticCommitType": "chore",
      "matchPackageNames": ["*"]
    },
    {
      "description": "Group Cargo updates within existing compatibility ranges",
      "matchManagers": ["cargo"],
      "matchIsBreaking": false,
      "groupName": "cargo dependencies"
    },
    {
      "description": "Review Cargo compatibility changes separately",
      "matchManagers": ["cargo"],
      "matchIsBreaking": true,
      "groupName": null
    }
  ]
}
